# ---- secrets -- never commit -------------------------------------------------
# LIVEKIT_API_SECRET is a signing key: anyone holding it can mint tokens for the
# rooms. .env.example is the template that IS tracked.
.env
*.pem
*.key

# ---- environments ------------------------------------------------------------
# 2.9 GB, of which 2.0 GB is the vendored mujoco_menagerie. Rebuild with
#   uv venv --python 3.12 .venv && uv pip install mujoco playground brax
.venv/
__pycache__/
*.pyc

# ---- large generated artefacts -----------------------------------------------
# videos/ is ~197 MB of rollout renders. The two clips used in the write-up live
# in demo/ and are tracked; everything else is reproducible from the scripts.
videos/

# Checkpoints pulled from the HF bucket on demand by local_view.py -- a cache,
# not source. Refetch with `hf buckets sync`.
checkpoints/

# 2.6 MB of base64 that duplicates demo/*.mp4 and diffs terribly.
# Rebuild with `python build_page.py`.
friction_gap.html

# ---- job scratch -------------------------------------------------------------
logs/
*.tmp

# ---- macOS / runtime noise -----------------------------------------------
.DS_Store
**/.DS_Store
stream.log

# ---- video artefacts ------------------------------------------------------
# Videos live in the HF dataset repo (abhijitbetigeri/himalaya-g1-demo), not here.
# demo/watch alone is ~244 MB; keeping renders in the code repo makes it painful
# to clone for no benefit, since every clip is reproducible from these scripts.
demo/watch/
demo/watch2/
demo/BEST/
*.mp4
